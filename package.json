{
  "name": "shadow-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "cd crate && wasm-pack build --target web --out-dir ../pkg --release && node ../scripts/copy-wasm.mjs",
    "test": "cd crate && cargo test --release",
    "test:browser": "npx playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:all": "npm run test && npm run test:browser",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "gh-pages -d out"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.4.27",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "playwright": "^1.61.0"
  }
}
