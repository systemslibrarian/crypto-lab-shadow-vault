{
  "name": "shadow-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "cd crate && wasm-pack build --target web --out-dir ../pkg --release && node ../scripts/copy-wasm.mjs",
    "test": "cd crate && cargo test --release",
    "test:browser": "npx playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:all": "npm run test && npm run test:browser",
    "dev": "vite",
    "build": "npm run test:publish-request && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "gh workflow run pages.yml --repo systemslibrarian/crypto-lab-shadow-vault --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "playwright": "^1.63.0"
  }
}
